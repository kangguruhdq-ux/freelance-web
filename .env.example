# FreelanceHub Environment Variables

# PostgreSQL Database Connection URL
# For local Docker Compose / local PostgreSQL instance:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/freelancehub?schema=public"

# App Ports & URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
API_PORT=4000

# Security (for future authentication checkpoints)
JWT_SECRET="freelancehub_super_secret_jwt_key_for_development_only_replace_in_prod"
JWT_EXPIRES_IN="7d"

# Node Environment
NODE_ENV="development"
